// ============================================================================
// TAG:          DEV
// STATUS:       REJECTED (no edge after costs over 13 months; see README)
// NAME:         OBV_Cross_Auto (13,34,55) trend-hold
// FILE:         pine/dev/OBV_Cross_Auto.dev.pine
// DERIVED FROM: pine/original/OBV_Cross_Auto.original.pine
// DESCRIPTION:  Original OBV stack signals plus: same-bar intraday square-off
//               (close_all immediately=true), stale-carry safety close, entry
//               cutoff, N-bar entry confirmation, non-repainting higher-TF
//               filter (OBV state / price vs SMA), exit mode (chart flip / HTF
//               flip / square-off only), max entries per day, 1 pt round-trip
//               commission, fixed 1 unit.
// TESTED:       5m, Sep-2025..Oct-2026, 1 pt cost/trade:
//                 HTF 60 + chart-flip exit:  639 trades, -178 pts, PF 0.98
//                 HTF 60 + HTF-flip exit:    245 trades, -976 pts, PF 0.90
// ============================================================================
//@version=5
strategy("OBV_Cross_Auto (13,34,55) trend-hold", shorttitle="OBV_CA", overlay=true, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=100000, commission_type=strategy.commission.cash_per_order, commission_value=0.5, slippage=0)   // 0.5 pt per order = 1 pt per round trip

length  = input.int(13, "Price SMA",  minval=1)
length1 = input.int(34, "OBV SMA 1",  minval=1)
length2 = input.int(55, "OBV SMA 2",  minval=1)
modeIn  = input.string("Intraday", "Mode", options=["Intraday", "Interday"])
sideIn  = input.string("Both", "Side", options=["Both", "CE only (long)", "PE only (short)"])
useSL   = input.bool(false, "Stop at signal extreme (CE: lowest low, PE: highest high since flip)")
sqHHMM  = input.int(1515, "Intraday square-off (IST hhmm, bar close)", minval=900, maxval=1530)
cutHHMM = input.int(1500, "Intraday: no new entries from (IST hhmm, bar close)", minval=900, maxval=1530, tooltip="Signals on bars closing at or after this time only exit; they do not open a new trade. Set equal to the square-off time to disable.")
confirmN = input.int(0, "Entry confirmation bars", minval=0, tooltip="Enter only after the OBV state has held for this many bars after the flip bar. 0 = enter on the flip bar (original behaviour). Exits still happen on the flip itself.")
htfMode = input.string("OBV state", "Higher-TF filter", options=["Off", "OBV state", "Price vs SMA"], tooltip="CE entries only when the higher timeframe is bullish, PE only when bearish. Uses the last COMPLETED higher-TF bar (no repainting).")
htfTF   = input.timeframe("60", "Higher-TF timeframe", tooltip="60 for a 5m chart, 15 for a 1m chart.")
exitMode = input.string("HTF flip", "Exit on", options=["Chart flip", "HTF flip", "Square-off only"], tooltip="Chart flip: exit when the chart OBV state flips (original). HTF flip: exit only when the higher-TF state turns against the trade. Square-off only: hold until square-off or stop; no new entry while in a trade. HTF flip falls back to Chart flip when the HTF filter is Off.")
maxTrades = input.int(2, "Max entries per day (0 = no limit)", minval=0)

// OBV stack state, as a function so the same logic runs on the higher TF.
obvFlag() =>
    o  = ta.cum(math.sign(ta.change(close)) * volume)
    s  = ta.sma(close, length)
    s1 = ta.sma(o, length1)
    s2 = ta.sma(o, length2)
    var float f = 0.0
    f := ((o > s1 and s1 > s2) or (o > s2 and s2 > s1)) and (close > s or f == 1) ? 1.0 : 0.0
    f

obv  = ta.cum(math.sign(ta.change(close)) * volume)
sma1 = ta.sma(obv, length1)
sma2 = ta.sma(obv, length2)
buyFlag = obvFlag()

// Higher-TF state from the previous (completed) HTF bar: [1] + lookahead_on
// is the standard non-repainting pattern.
htfObvPrev() =>
    f = obvFlag()
    f[1]
htfSmaPrev() =>
    up = close > ta.sma(close, length) ? 1.0 : 0.0
    up[1]
htfObv = request.security(syminfo.tickerid, htfTF, htfObvPrev(), lookahead=barmerge.lookahead_on)
htfSma = request.security(syminfo.tickerid, htfTF, htfSmaPrev(), lookahead=barmerge.lookahead_on)
htfState = htfMode == "OBV state" ? htfObv : htfSma
htfBull  = htfMode == "Off" or htfState == 1.0
htfBear  = htfMode == "Off" or htfState == 0.0

bullSignal = buyFlag == 1.0 and buyFlag[1] == 0.0   // TE_BUY_CE
bearSignal = buyFlag == 0.0 and buyFlag[1] == 1.0   // TE_BUY_PE

// Confirmed entries: the flip happened exactly confirmN bars ago and the
// state has not changed since (barssince is 0 on the flip bar itself).
barsSinceFlip = ta.barssince(buyFlag != buyFlag[1])
confirmCE = buyFlag == 1.0 and barsSinceFlip == confirmN
confirmPE = buyFlag == 0.0 and barsSinceFlip == confirmN
// Stop = extreme from the flip bar through the confirmation bar.
lowSinceFlip  = ta.lowest(low,  confirmN + 1)
highSinceFlip = ta.highest(high, confirmN + 1)

// Exit rules per mode.
chartExit = exitMode == "Chart flip" or (exitMode == "HTF flip" and htfMode == "Off")
exitCE = chartExit ? bearSignal : exitMode == "HTF flip" ? htfState == 0.0 : false
exitPE = chartExit ? bullSignal : exitMode == "HTF flip" ? htfState == 1.0 : false
exitTag = chartExit ? "OBV flip" : "HTF flip"

isIntraday  = modeIn == "Intraday"
hhmmClose   = hour(time_close, "Asia/Kolkata") * 100 + minute(time_close, "Asia/Kolkata")
atSquareOff = isIntraday and hhmmClose >= sqHHMM
newDay      = timeframe.change("D")

var int entriesToday = 0
if newDay
    entriesToday := 0
underCap = maxTrades == 0 or entriesToday < maxTrades
flatOK   = exitMode != "Square-off only" or strategy.position_size == 0
canEnter = (not isIntraday or hhmmClose < cutHHMM) and underCap and flatOK
wantCE = sideIn != "PE only (short)"
wantPE = sideIn != "CE only (long)"

// Safety net: if a position survived into a new day (short session such as
// Muhurat, or missing bars before the square-off time), flatten it at once.
staleCarry = isIntraday and newDay and strategy.position_size != 0

var float slCE = na
var float slPE = na
if atSquareOff
    // immediately=true fills at this bar's close instead of next bar's open,
    // which on the day's last bar would be the next morning.
    strategy.close_all(comment="square-off", immediately=true)
else
    if staleCarry
        strategy.close_all(comment="stale carry", immediately=true)
    if exitCE
        strategy.close("CE", comment=exitTag)
    if exitPE
        strategy.close("PE", comment=exitTag)
    if confirmCE and wantCE and canEnter and htfBull and strategy.position_size <= 0
        slCE := lowSinceFlip
        entriesToday += 1
        strategy.entry("CE", strategy.long, comment="TE_BUY_CE")
    else if confirmPE and wantPE and canEnter and htfBear and strategy.position_size >= 0
        slPE := highSinceFlip
        entriesToday += 1
        strategy.entry("PE", strategy.short, comment="TE_BUY_PE")
if useSL and not atSquareOff
    if not na(slCE)
        strategy.exit("SL CE", "CE", stop=slCE)
    if not na(slPE)
        strategy.exit("SL PE", "PE", stop=slPE)

bgcolor(buyFlag == 1.0 ? color.new(color.green, 90) : na)
plotshape(bullSignal, "TE_BUY_CE", shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(bearSignal, "TE_BUY_PE", shape.triangledown, location.abovebar, color.red,   size=size.tiny)
plotshape(confirmN > 0 and confirmCE, "CE confirmed", shape.circle, location.belowbar, color.green, size=size.tiny)
plotshape(confirmN > 0 and confirmPE, "PE confirmed", shape.circle, location.abovebar, color.red,   size=size.tiny)
plot(obv,  "OBV",      display=display.data_window)
plot(sma1, "OBV_SMA1", display=display.data_window)
plot(sma2, "OBV_SMA2", display=display.data_window)
plot(htfMode == "Off" ? na : htfState, "HTF state (1 bull / 0 bear)", display=display.data_window)
