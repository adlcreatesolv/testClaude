// ============================================================================
// TAG:          DEV
// STATUS:       NOT YET TESTED (experiment E18)
// CHANGES:      2026-10-22 default exit = Supertrend trailing stop (user request).
//               2026-10-22 entry clarified by user: all 4 must agree, with 3
//               already aligned and the 4th just flipping (score 3 -> 4).
//               2026-10-22 user: several flipping on the same bar (e.g.
//               2 -> 4) also counts, so entry = score becomes 4.
// NAME:         Confluence4 Intraday (Supertrend, Pivot R1/S1, Bollinger, RSI)
// FILE:         pine/dev/Confluence4_Intraday.dev.pine
// DERIVED FROM: User's strategy spec, 2026-10-22 (no original script):
//               "Supertrend (10,3) is long, pivot points R1 crossed, Bollinger
//               band 2 SD crossed up or down, RSI over 70. Any 3 true, 4th can
//               give entry, any one flip can be exits. Intraday NIFTY."
// DESCRIPTION:  Four conditions per side, scored 0-4.
//               LONG:  Supertrend(10,3) up | close > daily pivot R1 |
//                      close > upper BB(20,2) | RSI(14) > 70
//               SHORT: Supertrend(10,3) down | close < daily pivot S1 |
//                      close < lower BB(20,2) | RSI(14) < 30
//               Entry: all 4 true on this bar AND fewer than 4 on the
//               previous bar (last missing condition(s) just flipped in).
//               Exit (default): trailing stop at the Supertrend line, moved
//               every bar, or Supertrend flip. Option: exit when any of the
//               4 conditions turns false.
//               Intraday: same-bar 15:15 IST square-off, no entries from
//               15:00, stale-carry close. Fixed 1 unit, 1 pt round-trip cost.
// INTERPRETATION (confirm with user): "crossed" is treated as a state (close
//               is beyond R1 / the band), because one-bar cross events almost
//               never coincide. Pivots = classic daily, from previous day.
// KNOWN ISSUES: All four conditions are momentum/overbought measures, so they
//               are highly correlated. "Any flip" exits (esp. BB, RSI) can be
//               very quick, so costs matter.
// ============================================================================
//@version=5
strategy("Confluence4 Intraday (ST, Pivot, BB, RSI)", shorttitle="CF4", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_order, commission_value=0.5, slippage=0)   // 0.5 pt per order = 1 pt per round trip

// --- Inputs ---
stFactor = input.float(3.0, "Supertrend factor", minval=0.1, group="Conditions")
stLen    = input.int(10, "Supertrend ATR length", minval=1, group="Conditions")
bbLen    = input.int(20, "Bollinger length", minval=1, group="Conditions")
bbMult   = input.float(2.0, "Bollinger std dev", minval=0.1, group="Conditions")
rsiLen   = input.int(14, "RSI length", minval=1, group="Conditions")
rsiHi    = input.float(70, "RSI long above", group="Conditions")
rsiLo    = input.float(30, "RSI short below", group="Conditions")
exitMode = input.string("Supertrend trail", "Exit on", options=["Supertrend trail", "Any condition flips"], group="Entry / exit", tooltip="Supertrend trail: stop order at the Supertrend line, moved every bar. Any condition flips: exit when any of the 4 conditions turns false.")
sideIn   = input.string("Both", "Side", options=["Both", "Long only", "Short only"], group="Entry / exit")
sqHHMM   = input.int(1515, "Square-off (IST hhmm, bar close)", minval=900, maxval=1530, group="Session")
cutHHMM  = input.int(1500, "No new entries from (IST hhmm, bar close)", minval=900, maxval=1530, group="Session")

// --- Condition 1: Supertrend (direction < 0 = uptrend in Pine v5) ---
[stLine, stDir] = ta.supertrend(stFactor, stLen)
stLong  = stDir < 0
stShort = stDir > 0

// --- Condition 2: classic daily pivots from the previous completed day ---
[pH, pL, pC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
pp = (pH + pL + pC) / 3
r1 = 2 * pp - pL
s1 = 2 * pp - pH
pivLong  = close > r1
pivShort = close < s1

// --- Condition 3: Bollinger Bands ---
[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, bbMult)
bbLong  = close > bbUp
bbShort = close < bbLo

// --- Condition 4: RSI ---
rsi = ta.rsi(close, rsiLen)
rsiLong  = rsi > rsiHi
rsiShort = rsi < rsiLo

// --- Scores ---
b2i(bool x) => x ? 1 : 0
longScore  = b2i(stLong) + b2i(pivLong) + b2i(bbLong) + b2i(rsiLong)
shortScore = b2i(stShort) + b2i(pivShort) + b2i(bbShort) + b2i(rsiShort)
isTrail  = exitMode == "Supertrend trail"
// Entry: all 4 agree on this bar and did not on the previous bar, i.e. the
// last missing condition(s) just flipped into place (3 -> 4 or 2 -> 4 etc.).
longSig  = longScore == 4 and longScore[1] < 4
shortSig = shortScore == 4 and shortScore[1] < 4

// Exit: trail mode exits on the stop (below) or a Supertrend flip; the
// other mode exits as soon as any of the 4 conditions turns false.
exitLong  = isTrail ? not stLong : longScore < 4
exitShort = isTrail ? not stShort : shortScore < 4

// --- Session rules ---
hhmmClose   = hour(time_close, "Asia/Kolkata") * 100 + minute(time_close, "Asia/Kolkata")
atSquareOff = hhmmClose >= sqHHMM
canEnter    = hhmmClose < cutHHMM
staleCarry  = timeframe.change("D") and strategy.position_size != 0
wantLong    = sideIn != "Short only"
wantShort   = sideIn != "Long only"

// --- Execution ---
if atSquareOff
    // Fill on this bar's close, not the next bar's open (= next morning).
    strategy.close_all(comment="square-off", immediately=true)
else
    if staleCarry
        strategy.close_all(comment="stale carry", immediately=true)
    if strategy.position_size > 0 and exitLong
        strategy.close("Long", comment="flip")
    if strategy.position_size < 0 and exitShort
        strategy.close("Short", comment="flip")
    if longSig and wantLong and canEnter and strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="L" + str.tostring(longScore))
    else if shortSig and wantShort and canEnter and strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="S" + str.tostring(shortScore))

// --- Supertrend trailing stop: re-placed every bar at the current line ---
if isTrail and not atSquareOff
    if stLong
        strategy.exit("Trail L", "Long", stop=stLine, comment="ST trail")
    if stShort
        strategy.exit("Trail S", "Short", stop=stLine, comment="ST trail")

// --- Visuals ---
plot(stLine, "Supertrend", color=stLong ? color.green : color.red, style=plot.style_linebr)
plot(bbUp, "BB upper", color=color.new(color.gray, 40))
plot(bbLo, "BB lower", color=color.new(color.gray, 40))
plot(r1, "Pivot R1", color=color.new(color.teal, 0), style=plot.style_circles, linewidth=1)
plot(s1, "Pivot S1", color=color.new(color.maroon, 0), style=plot.style_circles, linewidth=1)
plotshape(longSig and wantLong and canEnter, "Long signal", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(shortSig and wantShort and canEnter, "Short signal", shape.triangledown, location.abovebar, color.red, size=size.tiny)
plot(longScore, "Long score", display=display.data_window)
plot(shortScore, "Short score", display=display.data_window)
plot(rsi, "RSI", display=display.data_window)
